# Local server settings. Production requires an explicit HTTPS PUBLIC_ORIGIN.
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
DB_PATH=./data/override.sqlite
# Required to enable Ranked sign-in. JSON from Firebase Console > Project settings > Your apps.
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","appId":""}
# Server-side Firebase Admin service account JSON; never expose this in the browser.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional for local development; production requires a persistent secret.
INVITATION_ENCRYPTION_KEY=
